# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo
# Per-package generated docs (e.g. packages/cli's `npm run docs` -> typedoc
# output at packages/cli/docs/). Anchored to packages/*/ so it never shadows
# the tracked root docs/ (architecture) — an unanchored `docs/` here previously
# made `!docs/architecture/` a no-op for new files, since git can't re-include
# a path whose parent directory is excluded.
packages/*/docs/

# Exception: VitePress docs site content (tracked, not generated)
!packages/site/docs/

# VitePress build artifacts
packages/site/docs/.vitepress/cache/
packages/site/docs/.vitepress/dist/

# Lien data
.lien/

# Testing
coverage/
*.log

# Environment
.env
.env.local

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Cursor (local mcp.json is machine-specific)
.cursor/mcp.json

# Claude Code (local settings are machine-specific)
.claude/settings.local.json

# Claude Code agent worktrees (full nested repo clones used as scratch
# space by CC agents; never meant to be committed or indexed)
.claude/worktrees/

# Playwright MCP scratch output (screenshots, console/page captures from
# browser-automation runs)
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# Terraform
*.tfplan
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars

# PHP
.phpunit.cache

# Python
__pycache__/
*.pyc

# Rust
target/

# Misc
*.orig
*.bak

# Retired hosted-platform (Laravel) checkout — see ADR-012. Never re-add.
/platform/

# Ad-hoc screenshots dropped at repo root (competitive analysis, dogfooding,
# manual QA) — not build output, just scratch. Root-only (not recursive) so
# real image assets under packages/*/public etc. are unaffected.
/*.png
/*.jpg
/*.jpeg
/*.gif

# Private documentation
.private/

# Work-in-progress documentation (temporary analysis, plans, reviews)
.wip/

# Test artifacts
test-tmp/
coverage/
.vitest/
.test-git-*
.test-watcher-*

packages/cli/README.md
scripts/experiments/dogfood-oss/trials/
